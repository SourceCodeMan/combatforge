# Git LFS for heavy Fab / Megascans content (GitHub 100MB hard limit)
Content/Scene_Warehouse/** filter=lfs diff=lfs merge=lfs -text
Content/Survival_Character/** filter=lfs diff=lfs merge=lfs -text
Content/QuantumCharacter/** filter=lfs diff=lfs merge=lfs -text
Content/MaterialsScifi/** filter=lfs diff=lfs merge=lfs -text
Content/Bandits/** filter=lfs diff=lfs merge=lfs -text

# Line endings — shell scripts MUST stay LF (a CRLF .command/.sh breaks bash on Mac/Linux).
*.command text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Modern Weapons pack (Fab paid content — private repo only)
Content/MarketplaceBlockout/** filter=lfs diff=lfs merge=lfs -text

# Shooter Rifle Animations pack (Fab paid content — private repo only). Load-bearing: the TP weapon
# hold pose and the first-person arms both solve against AS_Rifle_Aim / AS_Rifle_Fire_Aim here, and
# DefaultGame.ini force-cooks /Game/RifleAnims. Without it a build ships T-posing characters.
Content/RifleAnims/** filter=lfs diff=lfs merge=lfs -text
