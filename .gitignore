# CombatForge .gitignore — Unreal Engine 5.6 project.
# NOTE: Config/ and Content/ are TRACKED. Content/ ships empty except
# Content/Maps/.gitkeep and (once created on the PC, per contract T17)
# Content/Maps/L_Graybox.umap.

# --- Unreal Engine generated ---
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Plugins/**/Binaries/
Plugins/**/Intermediate/

# --- Visual Studio / project files (regenerated from the .uproject) ---
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# --- Rider / other IDEs ---
.idea/
.vsconfig
*.DotSettings.user

# --- Xcode (code is authored on macOS) ---
*.xcodeproj
*.xcworkspace

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- Packaged playtest / server drops (local only) ---
Packaged/
Build/
# Client logs shipped over the wire land under Saved/ (already ignored via Saved/)
Deploy/playtest/docker/server-linux/**
!Deploy/playtest/docker/server-linux/.gitkeep

# --- Staged Fab / Megascans / Lyra dumps at project root (not game Content) ---
LyraStarterGame/
DerelictCorridorMegascans/
MilitaryTrenchMegascansSa/
**/Megascans*/

# --- Crash dumps / local logs outside Saved/ ---
*.dmp

# --- Local junk ---
Scripts/__pycache__/
UpgradeLog.htm
*.pyc


# Fab Niagara Examples pack (local install; soft-loaded from /Game/NiagaraExamples when present)
Content/NiagaraExamples/

# parked non-cookable content packs (moved out of Content/ so the cooker skips them)
_parked_content/
